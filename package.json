{
  "name": "tai-learning-os",
  "private": true,
  "version": "0.1.0",
  "description": "He dieu hanh hoc tap Tai — local-first MVP. Vietnamese-first, evidence-based, parent-governed.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "npm run typecheck:worker && npm run typecheck:app",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:migrate": "wrangler d1 migrations apply tai-learning-os --local",
    "db:dump": "wrangler d1 export tai-learning-os --local",
    "db:reset-data": "node scripts/reset-local-d1.mjs",
    "seed:demo": "node scripts/seed-lessons.mjs",
    "hash:password": "node scripts/hash-parent-password.mjs",
    "export:learner": "node scripts/export-learner.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261024.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  }
}

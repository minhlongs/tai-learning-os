{
  "name": "tai-learning-os",
  "private": true,
  "version": "0.1.0",
  "description": "TAI Learning OS — local-first MVP. Vietnamese-first, evidence-based, parent-governed.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "npm run typecheck:worker && npm run typecheck:app",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "node scripts/run-e2e.mjs",
    "db:migrate": "node scripts/migrate-local-d1.mjs",
    "db:dump": "node scripts/dump-local-d1.mjs",
    "db:reset-data": "node scripts/reset-local-d1.mjs",
    "db:reprovision-household": "node scripts/reprovision-household-db.mjs",
    "household:preflight": "node scripts/household-preflight.mjs",
    "household:approve-lessons": "node scripts/approve-household-lessons.mjs",
    "seed:demo": "node scripts/seed-lessons.mjs",
    "seed:pilot": "node scripts/seed-pilot.mjs",
    "hash:password": "node scripts/hash-parent-password.mjs",
    "unlock:parent": "node scripts/unlock-parent.mjs",
    "export:learner": "node scripts/export-learner.mjs",
    "export:portability": "node scripts/export-portability.mjs",
    "backup:drill": "node scripts/backup-restore-drill.mjs",
    "validate:lessons": "node scripts/validate-lessons.mjs",
    "qa:content": "node scripts/qa-content.mjs",
    "review:simulate": "node scripts/review-simulate.mjs",
    "tco:verify": "node scripts/tco-verify.mjs",
    "curriculum:coverage": "node scripts/curriculum-coverage.mjs",
    "retention:report": "node scripts/retention-report.mjs",
    "retention:drill": "node scripts/retention-drill.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run validate:lessons && npm run qa:content && npm run review:simulate && npm run tco:verify && npm run build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ts-fsrs": "6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "5.20261024.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  }
}

{
  // He dieu hanh hoc tap Tai — Worker & D1 configuration.
  // LOCAL ONLY: this config must never be deployed without founder authorization.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tai-learning-os",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-24",

  // Static SPA assets (React build output). SPA routes do not hit the Worker.
  "assets": {
    "not_found_handling": "single-page-application"
  },

  // Local D1 database. Migrations live in ./migrations.
  // NOTE: `preview_database_id` is required for local migrations.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tai-learning-os",
      "database_id": "local-only",
      "preview_database_id": "local-preview"
    }
  ],

  // Native Rate Limiting binding — protects the login endpoint against
  // brute-force attempts. namespace_id must be a stable integer 1...
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ],

  // Fail closed: no secrets in source. Secrets are supplied at deploy time via
  // `wrangler secret put`; locally via .dev.vars (gitignored).
  //
  // PARENT_PASSWORD_HASH  — PBKDF2-SHA256 hash of the parent's password (600,000 iterations; see docs/DATA_MODEL.md §6)
  // SESSION_SECRET        — high-entropy secret used to sign session tokens
  //
  // ENVIRONMENT is deliberately NOT declared here. The config guard treats an
  // unset ENVIRONMENT as production, so first-run parent creation — the one
  // behaviour that `ENVIRONMENT: "development"` unlocks — cannot be switched
  // back on by shipping this file. Local development sets it in .dev.vars.
  "vars": {}
}
